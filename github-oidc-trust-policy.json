      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:RuthMayani@256419290/ecr-multi-env-capstone@1375599598:environment:dev",
            "repo:RuthMayani@256419290/ecr-multi-env-capstone@1375599598:environment:staging",
            "repo:RuthMayani@256419290/ecr-multi-env-capstone@1375599598:environment:prod"
          ]
        }
      }
    }
  ]
}
