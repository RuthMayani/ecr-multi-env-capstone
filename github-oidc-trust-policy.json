{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::992382578912:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "ForAnyValue:StringEquals": {
          "token.actions.githubusercontent.com:sub": [
            "repo:RuthMayani/ecr-multi-env-capstone:environment:dev",
            "repo:RuthMayani/ecr-multi-env-capstone:environment:staging",
            "repo:RuthMayani/ecr-multi-env-capstone:environment:prod"
          ]
        }
      }
    }
  ]
}
